<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The 3D physics module's public surface without the engine: the ECS components (RigidBody3D, Collider3D, Joint3D), the
    collision and trigger events, the query types, IPhysicsWorld3D and Physics3DConfig. A game library can depend on this
    package only; the game adds Ion.Extensions.Physics3D (AddPhysics3D/UsePhysics3D, BepuPhysics v2).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release;DebugGenerators</Configurations>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Ion.Extensions.Physics3D</RootNamespace>
    <Description>Ion 3D physics abstractions: RigidBody3D, Collider3D (box, sphere, capsule, cylinder, convex hull) and Joint3D (ball socket, hinge, weld, distance) ECS components, Collision3D and Trigger3D events, ray cast and overlap query types, IPhysicsWorld3D and Physics3DConfig.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ion.Extensions.Physics3D" />
    <InternalsVisibleTo Include="Ion.Extensions.Physics3D.Tests" />
    <InternalsVisibleTo Include="Ion.Benchmarks" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ion.Core.Abstractions\Ion.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Ion.Extensions.Ecs.Abstractions\Ion.Extensions.Ecs.Abstractions.csproj" />
  </ItemGroup>
</Project>

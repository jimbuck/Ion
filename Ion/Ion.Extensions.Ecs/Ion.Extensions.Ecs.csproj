<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The ECS module on Arch 2.1 (picked by measurement, roadmap 5.7): a World per scene scope (and a root World),
    Commands played back at the end of every stage, [Query] steps, the transform hierarchy, sprite animation, entity
    names, the FrameStats entity counter and world serialization (JSON and binary).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release;DebugGenerators</Configurations>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Ion.Extensions.Ecs</RootNamespace>
    <Description>Ion's ECS module on Arch 2.1: AddEcs()/UseEcs(), a World per scene scope, Commands played back at the end of every stage, generated [Query] loops, transform propagation (2D and 3D, Parent/Children), sprite animation, NameRegistry, FrameStats.Entities and JSON/binary world serialization.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ion.Extensions.Ecs.Tests" />
    <InternalsVisibleTo Include="Ion.Extensions.Ecs.Rendering" />
    <InternalsVisibleTo Include="Ion.Benchmarks" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Ion schedule generator: expands this project's [Query] methods and intercepts its registrations. -->
    <ProjectReference Include="..\Ion.Generators\Ion.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Ion.Extensions.Ecs.Abstractions\Ion.Extensions.Ecs.Abstractions.csproj" />
    <ProjectReference Include="..\Ion.Extensions.Scenes.Abstractions\Ion.Extensions.Scenes.Abstractions.csproj" />
  </ItemGroup>
</Project>

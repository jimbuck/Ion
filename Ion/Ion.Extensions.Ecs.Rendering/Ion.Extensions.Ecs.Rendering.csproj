<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ECS render extraction: the world's sprites and main camera copied into the renderer every frame (Bevy's extraction
    model), so entities never reach the renderer and the renderer stays usable from non-ECS code. 2D today; the 3D
    extraction (MeshRenderer, lights, cameras) joins here on Rendering3D.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release;DebugGenerators</Configurations>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Ion.Extensions.Ecs.Rendering</RootNamespace>
    <Description>Ion ECS render extraction: SpriteExtractionSystem copies Sprite + GlobalTransform2D entities (minus Hidden, culled against the MainCamera's view) into ISpriteBatch in Render at StageOrder.Extract, sorted by depth.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ion.Extensions.Ecs.Tests" />
    <InternalsVisibleTo Include="Ion.Benchmarks" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ion.Generators\Ion.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Ion.Extensions.Ecs\Ion.Extensions.Ecs.csproj" />
    <ProjectReference Include="..\Ion.Extensions.Graphics.Abstractions\Ion.Extensions.Graphics.Abstractions.csproj" />
  </ItemGroup>
</Project>

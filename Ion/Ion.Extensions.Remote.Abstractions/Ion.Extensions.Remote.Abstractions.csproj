<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The remote inspection protocol's extension surface: IRemoteMethodProvider (modules such as the ECS, UI and physics
    register their JSON-RPC methods through it without referencing the server), RemoteRequest, RemoteException and the
    error codes, remote resources and events, and the Ion.Remote.IsSupported feature switch. No transport code.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Ion.Extensions.Remote</RootNamespace>
    <Description>Ion remote inspection protocol abstractions: IRemoteMethodProvider, RemoteMethod, RemoteRequest, RemoteException, remote resources and events, and the Ion.Remote.IsSupported feature switch.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ion.Core.Abstractions\Ion.Core.Abstractions.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Ion.Extensions.Graphics.Vulkan</RootNamespace>
    <Description>Vulkan backend of Ion's RHI on Silk.NET.Vulkan: windowed (swapchain on a Silk.NET window) or offscreen, frames in flight, staging uploads, SPIR-V shaders, PNG screenshots.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleToSuffix Include=".Tests" />
    <InternalsVisibleTo Include="Ion.Extensions.Graphics.Headless" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated function-pointer bindings: AOT-clean themselves; Silk.NET.Core's native library loader has known
         IL3000/IL3002 warnings (see docs/plans/spikes/2026-silknet-spike.md). -->
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Silk.NET NativeAOT substitutions (shared with the windowing module), auto-imported by package consumers. -->
    <None Include="..\Ion.Extensions.Windowing.SilkNet\buildTransitive\*.xml" Pack="true" PackagePath="buildTransitive\" Visible="false" />
    <None Include="..\Ion.Extensions.Windowing.SilkNet\buildTransitive\Ion.Extensions.Windowing.SilkNet.targets" Pack="true" PackagePath="buildTransitive\Ion.Extensions.Graphics.Vulkan.targets" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Ion schedule generator: intercepts this project's registrations (reflection-free). -->
    <ProjectReference Include="..\Ion.Generators\Ion.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Ion.Core.Abstractions\Ion.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Ion.Extensions.Graphics.Abstractions\Ion.Extensions.Graphics.Abstractions.csproj" />
  </ItemGroup>
</Project>

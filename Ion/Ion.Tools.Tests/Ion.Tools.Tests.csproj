<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The remote module is compiled out of Release builds by default; the in-process MCP tests need it. -->
    <IonRemote>true</IonRemote>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Ion.Core.Tests\TestConstants.cs" Link="TestConstants.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ion.Tools\Ion.Tools.csproj" />
    <ProjectReference Include="..\Ion.Tools.Mcp\Ion.Tools.Mcp.csproj" />
    <!-- For RenderingEnvironment (whether screenshots can be taken here). -->
    <ProjectReference Include="..\Ion.Testing\Ion.Testing.csproj" />
    <ProjectReference Include="..\Ion.Extensions.UI\Ion.Extensions.UI.csproj" />
    <ProjectReference Include="..\Ion.Extensions.UI.Remote\Ion.Extensions.UI.Remote.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Text.Json.Nodes" />
  </ItemGroup>
</Project>

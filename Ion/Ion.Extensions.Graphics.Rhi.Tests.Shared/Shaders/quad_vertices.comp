#version 450
// Writes the six vertices (clip-space positions, depth 0.5) of a quad covering the left half of the target, for a draw
// that reads them as a vertex buffer.

layout(local_size_x = 8) in;

layout(set = 0, binding = 0) buffer Vertices
{
	vec4 positions[];
} uVertices;

const vec2 corners[6] = vec2[6](vec2(-1.0, -1.0), vec2(0.0, -1.0), vec2(0.0, 1.0), vec2(-1.0, -1.0), vec2(0.0, 1.0), vec2(-1.0, 1.0));

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= 6u) return;
	uVertices.positions[i] = vec4(corners[i], 0.5, 1.0);
}

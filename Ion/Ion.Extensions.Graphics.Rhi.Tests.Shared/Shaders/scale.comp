#version 450
// output[i] = input[i] * scale + offset for every i below count (the last workgroup runs past the end).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform Params
{
	uint count;
	float scale;
	float offset;
	float pad;
} uParams;

layout(set = 0, binding = 1) readonly buffer Input
{
	float values[];
} uInput;

layout(set = 0, binding = 2) buffer Output
{
	float values[];
} uOutput;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= uParams.count) return;
	uOutput.values[i] = uInput.values[i] * uParams.scale + uParams.offset;
}

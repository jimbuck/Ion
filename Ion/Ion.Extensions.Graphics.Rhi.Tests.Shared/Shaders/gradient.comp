#version 450
// Writes (x * 16, y * 16, 255, 255) / 255 into every texel of a storage texture.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D uImage;

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(uImage);
	if (p.x >= size.x || p.y >= size.y) return;
	imageStore(uImage, p, vec4(vec2(p * 16) / 255.0, 1.0, 1.0));
}

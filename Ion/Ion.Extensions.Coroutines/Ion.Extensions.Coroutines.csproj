    <ProjectReference Include="..\Ion.Core.Abstractions\Ion.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Ion.Extensions.Coroutines.Abstractions\Ion.Extensions.Coroutines.Abstractions.csproj" />
  </ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A small game with top-level statements whose entry point Ion.Testing.Tests runs (IonTestHost.UseEntryPoint<Program>(),
    IonEntryPoint). Command line switches make it misbehave on purpose: see Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU</Platforms>
    <!-- A test fixture, not an engine library. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableConfigurationBindingGenerator>false</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Ion schedule generator: intercepts the registrations and declares Program public. -->
    <ProjectReference Include="..\Ion.Generators\Ion.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Ion\Ion.csproj" />
  </ItemGroup>
</Project>

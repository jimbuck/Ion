<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ion.Core.Abstractions\Ion.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Ion.Extensions.Assets.Abstractions\Ion.Extensions.Assets.Abstractions.csproj" />
    <ProjectReference Include="..\Ion.Extensions.Audio.Abstractions\Ion.Extensions.Audio.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Managed decoders, decoded once at load time: MP3 (MPEG 1/2 layers 1-3) and OGG Vorbis. -->
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <!--
      Device output: OpenAL Soft binaries for win (x86/x64/arm64), osx (x64/arm64) and linux (arm/arm64/x64), bound by
      OpenAlNative through function pointers. Silk.NET.OpenAL itself is not referenced: its loader (Silk.NET.Core) pulls
      in Microsoft.Extensions.DependencyModel 9 and adds single-file/NativeAOT warnings (IL3000/IL3002).
    -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

</Project>

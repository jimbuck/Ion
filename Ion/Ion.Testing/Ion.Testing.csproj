<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <RootNamespace>Ion.Testing</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Headless test host for Ion games: build a game without a GPU, window or audio device, step it frame by frame with a deterministic clock, script input and assert on services, draw counts, sounds and events.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ion\Ion.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The remote inspection protocol (roadmap 4.10 item 6): JSON-RPC 2.0 over HTTP/1.1, WebSocket and stdio on
    System.Net.Sockets (no Kestrel), requests applied on the game thread at StageOrder.Remote in Last, bearer tokens,
    read and mutate scopes, idempotent mutations. Off unless Ion:Remote:Enabled (or the remote switch); compiled out of Release
    builds unless IonRemote=true (the Ion.Remote.IsSupported feature switch).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Ion.Extensions.Remote</RootNamespace>
    <Description>Ion's remote inspection protocol, modelled on the Bevy Remote Protocol: JSON-RPC 2.0 over HTTP, WebSocket and stdio, with world queries, component and resource reads and writes, schedule, metrics, screenshots, input injection, event and log tails, and +watch streams. Loopback only, per-run bearer tokens, read and mutate scopes.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ion.Extensions.Remote.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Ion schedule generator: intercepts this project's registrations (reflection-free). -->
    <ProjectReference Include="..\Ion.Generators\Ion.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Ion.Extensions.Remote.Abstractions\Ion.Extensions.Remote.Abstractions.csproj" />
    <!-- The HTTP/1.1 and WebSocket server core shared with the web module. -->
    <ProjectReference Include="..\Ion.Extensions.Http\Ion.Extensions.Http.csproj" />
    <ProjectReference Include="..\Ion.Core\Ion.Core.csproj" />
    <ProjectReference Include="..\Ion.Extensions.Metrics\Ion.Extensions.Metrics.csproj" />
    <ProjectReference Include="..\Ion.Extensions.Graphics.Abstractions\Ion.Extensions.Graphics.Abstractions.csproj" />
    <ProjectReference Include="..\Ion.Extensions.Scenes\Ion.Extensions.Scenes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive\Ion.Extensions.Remote.targets" Pack="true" PackagePath="buildTransitive\;build\" />
  </ItemGroup>
</Project>

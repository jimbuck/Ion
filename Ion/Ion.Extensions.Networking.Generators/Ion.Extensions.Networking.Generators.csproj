<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">

  <!-- LangVersion, Nullable, ImplicitUsings and Deterministic come from Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Analyzers never publish natively; ignore PublishAot passed on the command line (avoids NETSDK1207). -->
    <PublishAot>false</PublishAot>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Configurations>Debug;Release;DebugGenerators</Configurations>
    <Platforms>AnyCPU</Platforms>
    <RootNamespace>Ion.Extensions.Networking.Generators</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Ion.Extensions.Networking.Generators</PackageId>
    <Description>Compile-time serializers, delta encoders, interpolation and type registration for Ion's [Replicated] components and [NetworkMessage] structs, with the ION2xx diagnostics.</Description>
    <PackageTags>ion;game engine;analyzers;source generator;networking</PackageTags>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn 4.4 is the oldest compiler shipped with a .NET 8 SDK; newer references break 8.0.1xx SDKs (CS9057). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.4.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared minimal source writer and the netstandard2.0 polyfills. -->
    <Compile Include="..\Ion.Core.InternalGenerators\SourceWriter.cs" Link="Shared\SourceWriter.cs" />
    <Compile Include="..\Ion.Generators\Polyfills.cs" Link="Shared\Polyfills.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ion.Extensions.Networking.Generators.Tests" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>

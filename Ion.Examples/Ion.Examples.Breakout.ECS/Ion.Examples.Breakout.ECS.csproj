<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;DebugGenerators</Configurations>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Platforms>AnyCPU</Platforms>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <!-- NativeAOT: link Box2D's static library into the executable instead of shipping libbox2d next to it. -->
    <Box2DStaticLink>true</Box2DStaticLink>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="Assets\15-Breakout-Tiles.png" />
    <None Remove="Assets\49-Breakout-Tiles.png" />
    <None Remove="Assets\58-Breakout-Tiles.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\15-Breakout-Tiles.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\favicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\49-Breakout-Tiles.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\58-Breakout-Tiles.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
	  <!-- The Ion schedule generator: intercepts this project's registrations (reflection-free) and summarizes its Use* helpers. -->
    <ProjectReference Include="..\..\Ion\Ion.Generators\Ion.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\..\Ion\Ion.Extensions.Scenes.Generators\Ion.Extensions.Scenes.Generators.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\Ion\Ion\Ion.csproj" />
    <!-- The ECS module (Arch 2.1 comes with it) and its render extraction. -->
    <ProjectReference Include="..\..\Ion\Ion.Extensions.Ecs\Ion.Extensions.Ecs.csproj" />
    <ProjectReference Include="..\..\Ion\Ion.Extensions.Ecs.Rendering\Ion.Extensions.Ecs.Rendering.csproj" />
    <!-- The 2D physics module (Box2D v3 natives come with it). -->
    <ProjectReference Include="..\..\Ion\Ion.Extensions.Physics2D\Ion.Extensions.Physics2D.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\bonk.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Bungee-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\ping.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Numerics" />
  </ItemGroup>
  <!-- Tracy (dotnet run -p:IonTracy=true): the native bridge is only referenced, and the TRACY symbol only defined, on request. -->
  <PropertyGroup Condition="'$(IonTracy)' == 'true'">
    <DefineConstants>$(DefineConstants);TRACY</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IonTracy)' == 'true'">
    <ProjectReference Include="..\..\Ion\Ion.Extensions.Metrics.Tracy\Ion.Extensions.Metrics.Tracy.csproj" />
  </ItemGroup>
</Project>
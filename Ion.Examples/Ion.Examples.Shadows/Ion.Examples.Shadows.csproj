<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cascaded shadow maps: an avenue of pillars from the camera's feet to 150 units away, all shadowed by one sun.
    Keys 1 to 4 set the number of cascades, C tints what each cascade covers. Options: - -Ion:Rendering3D:ShadowCascades=N,
    - -Ion:Rendering3D:ShowShadowCascades=true, - -Ion:Run:Frames=N and - -Ion:Run:Screenshot=shadows.png,
    - -Ion:Headless=true (no window; add - -Ion:Headless:Render=true to render offscreen).
    Publishes with NativeAOT: dotnet publish -c Release -r linux-x64 -p:PublishAot=true
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;DebugGenerators</Configurations>
    <Platforms>AnyCPU</Platforms>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="appsettings.json" />
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- The HUD font (SIL Open Font License), shared with the Breakout ECS sample. -->
    <Content Include="..\Ion.Examples.Breakout\Assets\Bungee-Regular.ttf" Link="Assets\Bungee-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- The Ion schedule generator: intercepts this project's registrations and expands its [Query] steps (reflection-free). -->
    <ProjectReference Include="..\..\Ion\Ion.Generators\Ion.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\..\Ion\Ion\Ion.csproj" />
    <ProjectReference Include="..\..\Ion\Ion.Extensions.Ecs\Ion.Extensions.Ecs.csproj" />
    <ProjectReference Include="..\..\Ion\Ion.Extensions.Ecs.Rendering\Ion.Extensions.Ecs.Rendering.csproj" />
  </ItemGroup>
</Project>

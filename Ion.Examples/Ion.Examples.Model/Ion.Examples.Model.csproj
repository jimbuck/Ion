<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A glTF 2.0 model (Microsoft's CC0 "Avocado" from the Khronos sample assets) lit with the PBR material, a row of
    metallic-roughness spheres, a sun with shadows, two point lights and a skybox that also lights the scene, all as
    entities of the ECS module (the model spawned as one entity per glTF node) submitted by the 3D extraction.
    Options: - -Model:Frames=N (exit after N frames), - -Model:Screenshot=model.png (with Frames: save the last frame),
    - -Ion:Headless=true (no window; add - -Ion:Headless:Render=true to render offscreen).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;DebugGenerators</Configurations>
    <Platforms>AnyCPU</Platforms>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="appsettings.json" />
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The HUD font (SIL Open Font License), shared with the Breakout sample. -->
    <Content Include="..\Ion.Examples.Breakout\Assets\Bungee-Regular.ttf" Link="Assets\Bungee-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- The Ion schedule generator: intercepts this project's registrations (reflection-free). -->
    <ProjectReference Include="..\..\Ion\Ion.Generators\Ion.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\..\Ion\Ion\Ion.csproj" />
    <ProjectReference Include="..\..\Ion\Ion.Extensions.Ecs\Ion.Extensions.Ecs.csproj" />
    <ProjectReference Include="..\..\Ion\Ion.Extensions.Ecs.Rendering\Ion.Extensions.Ecs.Rendering.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Stage 5b replay runner: the 2D and 3D replay scenes of the physics tests (Replay2D.cs, Replay3D.cs, compiled from
    the test projects) run for 10,000 fixed steps, printing the hashes. Not part of Ion.sln: it exists to run the replay
    on linux-arm64 (NativeAOT cross-publish, QEMU user mode), where the test projects cannot run. See ../README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <!-- NativeAOT links the package's static libbox2d.a, unless Box2DNativeDir names a directory with <rid>/libbox2d.a (../native/build.sh). -->
    <Box2DStaticLink Condition="'$(Box2DNativeDir)' == ''">true</Box2DStaticLink>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\..\Ion\Ion.Extensions.Physics2D.Tests\Replay2D.cs" Link="Replay2D.cs" />
    <Compile Include="..\..\..\..\..\Ion\Ion.Extensions.Physics3D.Tests\Replay3D.cs" Link="Replay3D.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\Ion\Ion.Extensions.Ecs\Ion.Extensions.Ecs.csproj" />
    <ProjectReference Include="..\..\..\..\..\Ion\Ion.Extensions.Physics2D\Ion.Extensions.Physics2D.csproj" />
    <ProjectReference Include="..\..\..\..\..\Ion\Ion.Extensions.Physics3D\Ion.Extensions.Physics3D.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(Box2DNativeDir)' != ''">
    <DirectPInvoke Include="box2d" />
    <NativeLibrary Include="$(Box2DNativeDir)/$(RuntimeIdentifier)/libbox2d.a" />
  </ItemGroup>
</Project>

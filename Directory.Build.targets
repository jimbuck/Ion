<Project>
  <!-- NativeAOT: stub out Silk.NET code paths Ion never runs (packaged as buildTransitive for NuGet consumers). -->
  <Import Project="Ion\Ion.Extensions.Windowing.SilkNet\buildTransitive\Ion.Extensions.Windowing.SilkNet.targets" />
  <!-- The remote protocol's feature switch: compiled out of Release builds unless IonRemote=true (packaged as buildTransitive too). -->
  <Import Project="Ion\Ion.Extensions.Remote\buildTransitive\Ion.Extensions.Remote.targets" />
  <!-- Publishing presets (IonTarget): checks, the handheld default configuration and the ArkOS SD card layout. -->
  <Import Project="build\Ion.Publish.targets" />

  <Target Name="AddInternalsVisibleTo" BeforeTargets="BeforeCompile">
    <!-- Add default suffix if there is no InternalsVisibleTo or InternalsVisibleToSuffix defined -->
    <ItemGroup Condition="@(InternalsVisibleToSuffix-&gt;Count()) == 0 AND @(InternalsVisibleTo-&gt;Count()) == 0">
      <InternalsVisibleToSuffix Include=".Tests" />
    </ItemGroup>

    <!-- Handle InternalsVisibleTo -->
    <ItemGroup Condition="'@(InternalsVisibleTo-&gt;Count())' &gt; 0">
      <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
        <_Parameter1>%(InternalsVisibleTo.Identity)</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>

    <!-- Handle InternalsVisibleToSuffix -->
    <ItemGroup Condition="@(InternalsVisibleToSuffix-&gt;Count()) &gt; 0">
      <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
        <_Parameter1>$(AssemblyName)%(InternalsVisibleToSuffix.Identity)</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>